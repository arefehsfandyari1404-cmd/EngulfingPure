//+------------------------------------------------------------------+
//| Trade information panel (Part 14)                                |
//+------------------------------------------------------------------+
void DrawTradeInformation(const ENUM_POSITION_TYPE dir, const double entry, const double sl,
                          const double tp, const double atr, const double lot,
                          const datetime signalBarTime, const bool success, const uint retcode)
  {
   if(!ShowTradeInfo)
     { Comment(""); return; }
   string s;
   s  += "================ Pure Engulfing EA ================\n";
   s  += "Signal        : " + (dir == POSITION_TYPE_BUY ? "BULLISH ENGULFING (BUY)"
                               : "BEARISH ENGULFING (SELL)") + "\n";
   s  += "Signal candle : " + TimeToString(signalBarTime, TIME_DATE|TIME_MINUTES) + "\n";
   s  += "Direction     : " + (dir == POSITION_TYPE_BUY ? "BUY" : "SELL") + "\n";
   s  += "Entry (last)  : " + DoubleToString(entry, _Digits) + "\n";
   s  += "SL            : " + DoubleToString(sl, _Digits) + "\n";
   s  += "TP            : " + DoubleToString(tp, _Digits) + "\n";
   s  += "ATR           : " + DoubleToString(atr, _Digits) + "\n";
   s  += "Lot size      : " + DoubleToString(lot, 2) + "\n";
   s  += "Risk          : " + DoubleToString(RiskPercent, 2) + "% of equity = $ "
         + DoubleToString(AccountInfoDouble(ACCOUNT_EQUITY) * RiskPercent / 100.0, 2) + "\n";
   s  += "Result        : " + (success ? "OPENED"
                               : "REJECTED (retcode=" + IntegerToString(retcode) + ")") + "\n";
   s  += "====================================================\n";
   Comment(s);
  }
