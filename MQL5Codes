//| Trade logging + info panel update                                |
//+------------------------------------------------------------------+
void LogTradeResult(const ENUM_POSITION_TYPE dir, const bool sent, const double entry,
                    const double sl, const double tp, const double atr, const double lot,
                    const datetime signalBarTime)
  {
   uint retcode = trade.ResultRetcode();
   bool success = sent && (retcode == TRADE_RETCODE_DONE ||
                           retcode == TRADE_RETCODE_DONE_PARTIAL ||
                           retcode == TRADE_RETCODE_PLACED);
   if(success)
      Print("[TRADE] Position opened successfully (", (dir == POSITION_TYPE_BUY ? "BUY" : "SELL"),
            ", lot=", DoubleToString(lot, 2), ", order=", (string)trade.ResultOrder(),
            ", retcode=", (string)retcode, ")");
   else
      Print("[TRADE] Position rejected (retcode=", (string)retcode, " ",
            trade.ResultRetcodeDescription(), ")");
   DrawTradeInformation(dir, entry, sl, tp, atr, lot, signalBarTime, success, retcode);
  }

//+------------------------------------------------------------------+
//| Full pre-trade checklist + submission (Part 10)                  |
//+------------------------------------------------------------------+
void ProcessSignal(const ENUM_POSITION_TYPE dir,
                   const datetime signalBarTime,
                   const MqlRates &prev,
                   const MqlRates &curr)
                     {
//--- 1. permissions / allowed direction   2. spread
   int spread = CheckSpread();
   if(!CheckTradingConditions(dir, spread))
      return;

//--- R3: daily loss lock + daily trade cap
   if(!CheckDailyRiskLimits())
      return;

//--- 3. ATR
   double atr = GetATR();
   if(atr <= 0.0)
     { Print("[ERROR] ATR unavailable - trade skipped"); return; }

//--- 4./5./6. entry, SL, TP
   double bid = SymbolInfoDouble(_Symbol, SYMBOL_BID);
   double ask = SymbolInfoDouble(_Symbol, SYMBOL_ASK);

   if(bid <= 0.0 || ask <= 0.0)
     {
      Print("[ERROR] Invalid Bid/Ask - trade skipped");
      return;
     }

//--- Refresh entry immediately before calculating stops
   double entry = (dir == POSITION_TYPE_BUY) ? ask : bid;

//--- Structure-based SL using the complete engulfing pattern
double patternLow  = MathMin(prev.low, curr.low);
double patternHigh = MathMax(prev.high, curr.high);

double slBuffer = atr * SL_Buffer_ATR;

double sl = 0.0;
double tp = 0.0;

//--- BUY: SL below the lowest point of the engulfing pattern
if(dir == POSITION_TYPE_BUY)
  {
   sl = patternLow - slBuffer;
  }
//--- SELL: SL above the highest point of the engulfing pattern
else if(dir == POSITION_TYPE_SELL)
  {
   sl = patternHigh + slBuffer;
  }
else
  {
   return;
  }

//--- Risk = actual Entry -> SL distance
double riskDistance = MathAbs(entry - sl);

if(riskDistance <= 0.0)
  {
   Print("[ERROR] Invalid structure-based SL distance");
   return;
  }

//--- R5: enforce a minimum SL distance (ATR, spread, broker stop level)
double spreadDist  = ask - bid;
double stopLvlDist = (double)SymbolInfoInteger(_Symbol, SYMBOL_TRADE_STOPS_LEVEL) * _Point;

double minRiskDist = MathMax(MinSL_ATR_Mult * atr,
                     MathMax(MinSL_Spread_Mult * spreadDist, stopLvlDist));

if(riskDistance < minRiskDist)
  {
   riskDistance = minRiskDist;
   sl = (dir == POSITION_TYPE_BUY) ? entry - riskDistance
                                   : entry + riskDistance;
   Print("[RISK] SL widened to floor: dist=", DoubleToString(riskDistance, _Digits));
  }

//--- TP based on fixed Risk/Reward
double tpDistance = riskDistance * RiskReward;

tp = (dir == POSITION_TYPE_BUY)
     ? entry + tpDistance
     : entry - tpDistance;
     //--- 7. stop-level validation
   if(!ValidateStops(dir, entry, sl, tp))
      return;

   Print("[TRADE] ", (dir == POSITION_TYPE_BUY ? "BUY" : "SELL"), " signal | ATR = ",
         DoubleToString(atr, _Digits), " | SL = ", DoubleToString(sl, _Digits),
         " | TP = ", DoubleToString(tp, _Digits), " | Spread = ", spread, " points");

//--- 8. opposite signal handling
   int oppositeType = (dir == POSITION_TYPE_BUY) ? (int)POSITION_TYPE_SELL : (int)POSITION_TYPE_BUY;
   if(CloseOnOppositeSignal && CountOpenPositions(oppositeType) > 0)
      if(!CloseOppositePositions(oppositeType))
         return;

//--- 9. max positions
   if(CountOpenPositions() >= MaxPositions)
     {
      Print("[TRADE] MaxPositions (", MaxPositions, ") already reached - trade skipped");
      return;
     }

//--- 10. lot size
   double lot = CalculateLotSize(dir, entry, sl);
   if(lot <= 0.0)
      return;
   Print("[TRADE] Lot = ", DoubleToString(lot, 2));

//--- 11. margin validation
   if(!CheckMargin(dir, lot))
      return;

//--- 12. submit
   string tag = (dir == POSITION_TYPE_BUY ? "BUY" : "SELL") + " " + MakeObjectName("P", signalBarTime);
   bool sent = (dir == POSITION_TYPE_BUY) ? OpenBuy(lot, entry, sl, tp, tag)
               : OpenSell(lot, entry, sl, tp, tag);

//--- R3: count today's entries
   if(sent)
      g_dayTrades++;

//--- 13. verify + log
   LogTradeResult(dir, sent, entry, sl, tp, atr, lot, signalBarTime);
  }

//+------------------------------------------------------------------+
//| Unique object name: KIND_YYYYMMDD_HHMMSS (signal candle time)    |
//+------------------------------------------------------------------+
string MakeObjectName(string prefix, datetime t)
  {
   MqlDateTime dt;
   TimeToStruct(t, dt);

   string timeStr = StringFormat("%04d%02d%02d_%02d%02d%02d",
                                 dt.year,
                                 dt.mon,
                                 dt.day,
                                 dt.hour,
                                 dt.min,
                                 dt.sec);

   return prefix + "_" + timeStr;
  }
//+------------------------------------------------------------------+
//| Common object styling                                            |
//+------------------------------------------------------------------+
void ApplyObjectStyle(const string name)
  {
   ObjectSetInteger(0, name, OBJPROP_SELECTABLE, false);
   ObjectSetInteger(0, name, OBJPROP_HIDDEN, true);
   ObjectSetInteger(0, name, OBJPROP_BACK, false);
  }

//+------------------------------------------------------------------+
//| Bullish: yellow rectangle + up arrow + text, below the pattern   |
//+------------------------------------------------------------------+
void DrawBullishEngulfing(const MqlRates &prev, const MqlRates &curr)
  {
   double low  = MathMin(prev.low, curr.low);
   double high = MathMax(prev.high, curr.high);
   double pad  = (high - low > 0.0) ? (high - low) * 0.20 : 10.0 * _Point;

   int ps = PeriodSeconds(TradingTimeframe);
   if(ps <= 0)
      ps = PeriodSeconds(PERIOD_M1);
   long off = (long)(0.1 * ps);
   datetime t1 = prev.time - off;
   datetime t2 = curr.time + ps + off;

//--- rectangle around both candles
   string rectName = MakeObjectName("ENGULFING_BUY_RECT", curr.time);
   if(ObjectFind(0, rectName) < 0)
      if(ObjectCreate(0, rectName, OBJ_RECTANGLE, 0, t1, low - pad, t2, high + pad) < 0)
        { Print("[ERROR] Failed to create rectangle ", rectName); return; }
   ObjectSetInteger(0, rectName, OBJPROP_COLOR, clrYellow);
   ObjectSetInteger(0, rectName, OBJPROP_WIDTH, 1);
   ObjectSetInteger(0, rectName, OBJPROP_STYLE, STYLE_SOLID);
   ApplyObjectStyle(rectName);

//--- BUY marker below the pattern
   double markerPrice = low - pad * 1.5;
   string markerName = MakeObjectName("ENGULFING_BUY_MARK", curr.time);
   if(ObjectFind(0, markerName) < 0)
      if(ObjectCreate(0, markerName, OBJ_ARROW, 0, (datetime)curr.time, markerPrice) < 0)
        { Print("[ERROR] Failed to create marker ", markerName); return; }
   ObjectSetInteger(0, markerName, OBJPROP_ARROWCODE, 233); // up arrow
   ObjectSetInteger(0, markerName, OBJPROP_COLOR, clrYellow);
   ObjectSetInteger(0, markerName, OBJPROP_WIDTH, 2);
   ApplyObjectStyle(markerName);

//--- text label
   string textName = MakeObjectName("ENGULFING_BUY_TEXT", curr.time);
   if(ObjectFind(0, textName) < 0)
      if(ObjectCreate(0, textName, OBJ_TEXT, 0, (datetime)curr.time, markerPrice - pad * 0.3) < 0)
        { Print("[ERROR] Failed to create text ", textName); return; }
   ObjectSetString(0, textName, OBJPROP_TEXT, "BULLISH ENGULFING");
   ObjectSetInteger(0, textName, OBJPROP_COLOR, clrYellow);
   ObjectSetInteger(0, textName, OBJPROP_FONTSIZE, 8);
   ObjectSetString(0, textName, OBJPROP_FONT, "Arial");
   ObjectSetInteger(0, textName, OBJPROP_ANCHOR, ANCHOR_UPPER);
   ApplyObjectStyle(textName);
  }

